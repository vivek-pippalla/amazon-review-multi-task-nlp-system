# ─────────────────────────────────────────────────────────────────────────────
# .dockerignore — keep the build context lean
# ─────────────────────────────────────────────────────────────────────────────

# Version control
.git
.gitignore

# Python cache / bytecode
__pycache__/
*.py[codz]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / editor artefacts
.vscode/
.idea/
*.swp
*.swo
.cursorignore
.cursorindexingignore

# Jupyter notebooks (not needed at runtime)
*.ipynb
.ipynb_checkpoints/

# Documentation
docs/
documentation/
README.md
LICENSE

# Large ML model files — mounted as volumes at runtime
# (Uncomment the lines below if you want to COPY them into the image instead)
best_model.keras
tokenizer.pkl

# Test / CI artefacts
.coverage
.pytest_cache/
htmlcov/
*.log

# Environment files (never bake secrets into images)
.env
.env.*
!.env.example

# Docker files (no need to include them inside the image)
Dockerfile
docker-compose*.yml
.dockerignore

# OS artefacts
.DS_Store
Thumbs.db
