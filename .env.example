# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Root password used by the Docker MySQL container (only needed by Docker)
MYSQL_ROOT_PASSWORD=changeme_root

# Application database credentials
DB_HOST=localhost          # use "db" when running inside Docker Compose
DB_USER=absa_user
DB_PASSWORD=changeme_app
DB_NAME=nlp_app_db

# ── Ollama / LLM ──────────────────────────────────────────────────────────────
# Point to the Ollama instance.
# • Local dev (no Docker):  http://localhost:11434
# • Inside Docker Compose:  http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# ── Flask app ─────────────────────────────────────────────────────────────────
# Host port to expose the app on (default 5000)
APP_PORT=5000
